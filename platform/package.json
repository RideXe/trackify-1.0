{
  "name": "trackify-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trackify v2 — serverless, auto-scaling GPS fleet tracking platform on AWS",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "tools/*",
    "infra"
  ],
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "synth": "npm run synth -w @trackify/infra",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run synth"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/aws-lambda": "8.10.163",
    "@types/node": "24.13.4",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  }
}
