<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>
<properties>

    <!-- Documentation: https://www.trackify.org/configuration-file/ -->

    <!-- ── MySQL (AWS RDS) ── -->
    <!-- Fill in YOUR_RDS_ENDPOINT and YOUR_RDS_PASSWORD after creating the RDS instance (Phase 2 of deployment guide) -->
    <entry key='database.driver'>com.mysql.cj.jdbc.Driver</entry>
    <entry key='database.url'>jdbc:mysql://YOUR_RDS_ENDPOINT:3306/trackify?zeroDateTimeBehavior=round&amp;serverTimezone=UTC&amp;allowPublicKeyRetrieval=true&amp;useSSL=true&amp;requireSSL=true&amp;verifyServerCertificate=false&amp;allowMultiQueries=true&amp;autoReconnect=true</entry>
    <entry key='database.user'>admin</entry>
    <entry key='database.password'>YOUR_RDS_PASSWORD</entry>

</properties>
