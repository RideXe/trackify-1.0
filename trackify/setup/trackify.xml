<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>
<properties>

    <!-- Documentation: https://www.trackify.org/configuration-file/ -->

    <!-- Local runs use H2. Docker/AWS overrides these with environment variables
         (see docker-compose.yml) — never put real credentials in this file. -->
    <entry key='database.driver'>org.h2.Driver</entry>
    <entry key='database.url'>jdbc:h2:./data/database</entry>
    <entry key='database.user'>sa</entry>
    <entry key='database.password' />

    <!-- Only open ports for the trackers we use: GT06 5023, Teltonika 5027, phones (OsmAnd) 5055 -->
    <entry key='protocols.enable'>gt06,teltonika,osmand</entry>

</properties>
